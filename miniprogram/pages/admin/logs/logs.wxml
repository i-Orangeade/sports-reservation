<view class="container">
  <view class="card">
    <view class="type-tabs">
      <view class="type-tab {{activeModule === item.key ? 'active' : ''}}" wx:for="{{modules}}" wx:key="key" data-key="{{item.key}}" bindtap="onTapModule">{{item.name}}</view>
    </view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="_id">
    <view class="space-between">
      <text style="font-weight: 600;">{{item.actionText}}</text>
      <text class="tag green">{{item.operator_name}}</text>
    </view>
    <view class="text-muted" style="margin-top: 8rpx;">对象：{{item.target_desc}}</view>
    <view class="text-muted">时间：{{item.timeText}}</view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">暂无日志</view>
</view>
