.type-tabs {
  display: flex;
  gap: 16rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.type-tab.active {
  background: #1f7a4d;
  color: #fff;
}

.court-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.court {
  width: 21%;
  background: #e7f6ee;
  color: #1f7a4d;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
}

.court.closed {
  background: #fdecea;
  color: #d9534f;
}

.court-status {
  font-size: 20rpx;
  margin-top: 6rpx;
}

.op-btn {
  margin-top: 12rpx;
  font-size: 22rpx;
  text-decoration: underline;
}
