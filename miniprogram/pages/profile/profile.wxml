<view class="container">
  <view class="card">
    <view class="form-item">
      <view class="form-label">姓名</view>
      <input class="form-input" value="{{name}}" data-field="name" bindinput="onInput" placeholder="请输入姓名" />
    </view>
    <view class="form-item">
      <view class="form-label">学号</view>
      <input class="form-input" value="{{student_no}}" data-field="student_no" bindinput="onInput" placeholder="请输入学号" />
    </view>
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" value="{{phone}}" data-field="phone" bindinput="onInput" placeholder="请输入手机号" />
    </view>
    <view class="form-item">
      <view class="form-label">学院/单位</view>
      <input class="form-input" value="{{college}}" data-field="college" bindinput="onInput" placeholder="请输入学院/单位" />
    </view>
    <view class="btn" bindtap="save">保存</view>
  </view>
</view>
