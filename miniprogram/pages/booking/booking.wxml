<view class="container">
  <view class="banner" wx:if="{{blackDays > 0}}">您已被限制预约，{{blackDays}} 天内不可预约场馆</view>

  <view class="card">
    <view class="card-title">预约日期：{{date}}</view>
    <view class="text-muted" wx:if="{{isToday}}">今天可预约（{{date}}）</view>
    <view class="text-muted" wx:elif="{{!openReached}}">每天 {{openTime.hour}}:{{openTime.minute}} 开放次日预约</view>
    <view class="text-muted" wx:else>当前可预约</view>
  </view>

  <view class="card">
    <view class="card-title">场馆</view>
    <view class="type-tabs">
      <view
        class="type-tab {{activeType === item.key ? 'active' : ''}}"
        wx:for="{{types}}"
        wx:key="key"
        data-type="{{item.key}}"
        bindtap="onTapType"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">场次</view>
    <view class="slot-tabs">
      <view
        class="slot-tab {{activeSlotKey === item.slot_key ? 'active' : ''}}"
        wx:for="{{slots}}"
        wx:key="slot_key"
        data-key="{{item.slot_key}}"
        bindtap="onTapSlot"
      >{{item.start_time}}~{{item.end_time}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">选择场地</view>
    <view class="court-grid">
      <view
        class="court {{item.status}} {{selectedCourt === item.venue_key ? 'selected' : ''}}"
        wx:for="{{courts}}"
        wx:key="venue_key"
        data-key="{{item.venue_key}}"
        data-status="{{item.status}}"
        bindtap="onTapCourt"
      >
        <view>{{item.court_no}}号</view>
        <view class="court-status">{{item.status === 'available' ? '可预约' : (item.status === 'booked' ? '已约满' : '闭馆')}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!courts.length}}">暂无场地数据</view>
  </view>

  <view class="btn {{(!openReached || blackDays > 0 || !selectedCourt) ? 'disabled' : ''}}" bindtap="confirmBooking">提交预约</view>
</view>
