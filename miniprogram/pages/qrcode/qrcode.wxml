<view class="container" style="text-align: center;">
  <view class="card">
    <view class="card-title">个人身份二维码</view>
    <canvas canvas-id="qrcode" style="width: {{size}}px; height: {{size}}px; margin: 0 auto;"></canvas>
    <view class="text-muted" style="margin-top: 16rpx;">二维码 {{countdown}} 秒后自动刷新</view>
  </view>

  <view class="card" wx:if="{{hasValid}}">
    <view class="card-title">当前有效预约</view>
    <view class="info-row"><text>场馆：</text><text>{{booking.venue_type_name}}</text></view>
    <view class="info-row"><text>场地：</text><text>{{booking.court_no}} 号</text></view>
    <view class="info-row"><text>场次：</text><text>{{booking.start_time}} ~ {{booking.end_time}}</text></view>
    <view class="info-row"><text>日期：</text><text>{{booking.date}}</text></view>
  </view>
  <view class="card" wx:else>
    <view class="text-muted">当前无有效预约</view>
    <view class="text-muted">有效预约 = 今日场次开始前 15 分钟至结束</view>
  </view>
</view>
